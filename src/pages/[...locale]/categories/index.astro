---
import { SITE } from '~/config';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { getCategoriesWithCount, categoryPath } from '~/utils/posts';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const categories = await getCategoriesWithCount(locale);
---

<BaseLayout
  title={t('categories.title')}
  pathWithoutLocale="/categories/"
  crumbs={[{ label: t('categories.title') }]}
>
  <div class="ai-page-heading mb-10">
    <h1 class="ai-page-title">{t('categories.title')}</h1>
  </div>
  {
    categories.length === 0 ? (
      <p class="ai-empty">{t('categories.empty')}</p>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
        {categories.map((cat) => (
          <li>
            <a href={categoryPath(locale, cat.name)} class="ai-concept block">
              <span class="ai-concept__grad" aria-hidden="true" />
              <span class="ai-concept__index">
                <Icon name="lucide:layers" width={14} height={14} class="inline" />
              </span>
              <span class="ai-concept__title">{cat.name}</span>
              <span class="ai-concept__time">
                {cat.count} {cat.count === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
