---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout
  title={t('404.title')}
  description={t('404.description')}
  narrow={true}
  crumbs={[{ label: '404' }]}
>
  <section class="flex flex-col items-center px-6 py-20 text-center">
    <p
      class="text-7xl font-black tracking-tight"
      style="color:var(--color-primary);font-family:var(--font-display);font-weight:500"
    >
      404
    </p>
    <h1 class="ai-page-title mt-4 text-3xl sm:text-4xl">{t('404.title')}</h1>
    <p class="mt-2" style="color:var(--color-muted)">{t('404.description')}</p>
    <a href={localizedPath('/', locale)} class="ai-btn ai-btn-primary mt-6 px-6 py-3">
      {t('404.cta')}
    </a>
  </section>
</BaseLayout>
