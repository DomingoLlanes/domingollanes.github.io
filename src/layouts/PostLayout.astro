---
import BaseLayout from './BaseLayout.astro';
import PostNav from '../components/PostNav.astro';
import SmartImage from '../components/SmartImage.astro';
import TableOfContents from '../components/islands/TableOfContents.astro';
import Giscus from '../components/islands/Giscus.astro';
import MathStyles from '../components/MathStyles.astro';
import CategoryChip from '../components/CategoryChip.astro';
import { Icon } from 'astro-icon/components';
import { GISCUS, SITE, type Locale } from '../config';
import { useTranslations, stripLocale, formatDate, isoDate, localizedPath } from '../i18n/utils';
import { readingTime } from '../utils/reading-time';
import {
  type Post,
  tagPath,
  getTranslations,
  postPath,
  postSlug,
  heroImage,
  heroImageSrc,
  shouldShowHero,
  getPosts,
} from '../utils/posts';
import { buildSeo } from '../utils/seo';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  /** Astro's `headings` array from `await render(post)`. */
  headings: MarkdownHeading[];
  /** Raw body string used for reading time. */
  body: string;
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { post, headings, body, prev, next, locale } = Astro.props;
const t = useTranslations(locale);
const minutes = readingTime(body).minutes;

// Translation siblings (used by language switcher links).
const translations = await getTranslations(post);
const translationLinks: Partial<Record<Locale, string>> = {};
for (const [lang, p] of Object.entries(translations)) {
  if (p) translationLinks[lang as Locale] = postPath(p);
}
// Locales that actually have a published version of this post.
const availableLocales = (Object.keys(translationLinks) as Locale[]).sort();

const commentsEnabled = post.data.comments !== false && GISCUS.enabled;
const pathWithoutLocale = stripLocale(Astro.url.pathname);

const heroSrc = heroImageSrc(post);
const heroAsset = heroImage(post);
const showHero = shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? '';

// Related posts: same category first, then by recency, excluding current.
const allPosts = (await getPosts(locale)).filter((p) => p.id !== post.id);
const category = post.data.categories[0] ?? '';
const related = [
  ...allPosts.filter((p) => p.data.categories.includes(category)),
  ...allPosts.filter((p) => !p.data.categories.includes(category)),
].slice(0, 3);

// Use hero image for OG if available, otherwise fallback to the generated OG image
// (unless Auto-OG is disabled globally or skipped in CI).
const ogSlug = postSlug(post);
const ogPrefix = locale === SITE.defaultLocale ? '' : `${locale}/`;
const generatedOgPath = `/og/${ogPrefix}${ogSlug}.png`;
const skipAutoOg = !SITE.autoOgImage || import.meta.env.CI_SKIP_AUTO_OG_IMAGE === 'true';
const ogImage = heroSrc ?? (skipAutoOg ? undefined : generatedOgPath);

const seo = buildSeo({
  title: post.data.title,
  description: post.data.description,
  pathWithoutLocale,
  fullPath: Astro.url.pathname,
  locale,
  ogImage,
  type: 'article',
  publishedTime: post.data.pubDate,
  modifiedTime: post.data.updatedDate,
  tags: post.data.tags,
  availableLocales,
  // An unlisted post hides from SEO by default unless the author
  // explicitly sets `unlistedHideFromSeo: false`.
  noindex: post.data.unlisted && (post.data.unlistedHideFromSeo ?? true),
});

const crumbs = [
  { label: t('nav.posts'), href: localizedPath('/', locale) },
  { label: post.data.title },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  crumbs={crumbs}
  seo={seo}
  availableLocales={availableLocales}
>
  {post.data.math && <MathStyles />}

  <article>
    {/* === Header === */}
    <header class="ai-article-header">
      <a href={localizedPath('/', locale)} class="ai-kicker mb-8 w-fit">
        <Icon name="lucide:arrow-left" width={14} height={14} />
        {t('nav.posts')}
      </a>

      <div class="ai-post-row__kind mb-5">
        {category && <CategoryChip label={category} />}
        <time datetime={isoDate(post.data.pubDate)} class="ai-post-row__meta">
          {formatDate(post.data.pubDate, locale, {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          })}
          {' · '}
          {minutes} min
        </time>
      </div>

      <h1 class="ai-article-title mb-6">{post.data.title}</h1>

      <p class="ai-sub mb-8 max-w-2xl text-lg">{post.data.description}</p>

      <div class="ai-author">
        <span class="ai-avatar h-11 w-11" aria-hidden="true">
          {SITE.author.name.charAt(0)}
        </span>
        <p class="ai-byline">
          <span class="font-semibold" style="color:var(--color-ink)">
            {SITE.author.name}
          </span>
          <br />
          {SITE.author.bio}
        </p>
      </div>
    </header>

    {
      showHero && heroAsset && (
        <figure class="mt-10">
          <SmartImage
            src={heroAsset}
            alt={heroAlt}
            class="block w-full"
            style="max-width:100%;height:auto;object-fit:cover;border-radius:0.5rem"
            loading="eager"
            widths={[480, 768, 1024, 1280, 1600]}
            sizes="(max-width: 768px) 100vw, 900px"
            quality={82}
          />
          {heroAlt && (
            <figcaption class="mt-2 text-center text-xs" style="color:var(--color-muted)">
              {heroAlt}
            </figcaption>
          )}
        </figure>
      )
    }

    {/* === Body: lateral TOC + prose column === */}
    <div
      class:list={[
        'ai-layout-article',
        post.data.toc && headings.length > 0 ? 'ai-layout-article--toc' : '',
      ]}
    >
      {post.data.toc && headings.length > 0 && (
        <TableOfContents headings={headings} locale={locale} />
      )}
      <div class="ai-article-body">
        <div class="prose-ai max-w-none">
          <slot />
        </div>

        {
          post.data.tags.length > 0 && (
            <footer class="mt-12 flex flex-wrap items-center gap-2 border-t pt-8">
              <span class="ai-post-row__meta mr-2">{t('post.tags')}</span>
              {post.data.tags.map((tag) => (
                <a href={tagPath(locale, tag)} class="ai-tag text-xs">
                  #{tag}
                </a>
              ))}
            </footer>
          )
        }
      </div>
    </div>

    {/* === Author box === */}
    <div class="ai-author-box mt-14">
      <span class="ai-avatar h-14 w-14 text-base" aria-hidden="true">
        {SITE.author.name.charAt(0)}
      </span>
      <div class="flex flex-1 flex-col gap-1.5">
        <p class="ai-author-box__name">{SITE.author.name}</p>
        <p class="ai-author-box__bio">{SITE.author.bio}</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="ai-post-row__meta">{t('post.share')}</span>
        <a href={postPath(post)} class="ai-btn ai-btn-outline h-10 w-10 rounded-full" aria-label={t('post.copyLink')}>
          <Icon name="lucide:link" width={15} height={15} />
        </a>
        <a href={localizedPath('/rss.xml', locale)} class="ai-btn ai-btn-outline h-10 w-10 rounded-full" aria-label="RSS">
          <Icon name="lucide:rss" width={15} height={15} />
        </a>
      </div>
    </div>

    {/* === Prev / next === */}
    <div class="mt-10">
      <PostNav prev={prev} next={next} locale={locale} />
    </div>

    {
      commentsEnabled ? (
        <div class="mt-12">
          <Giscus locale={locale} />
        </div>
      ) : (
        post.data.comments === false && (
          <p class="mt-12 text-sm" style="color:var(--color-muted)">
            {t('post.commentsDisabled')}
          </p>
        )
      )
    }

    {/* === Related posts === */}
    {
      related.length > 0 && (
        <section class="mt-16" aria-label={t('post.related')}>
          <h2 class="ai-display mb-8 text-3xl">{t('post.related')}</h2>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {related.map((p) => (
              <a href={postPath(p)} class="ai-related__card block">
                {p.data.categories[0] && (
                  <div class="ai-post-row__kind">
                    <CategoryChip label={p.data.categories[0]} />
                  </div>
                )}
                <span class="ai-related__title line-clamp-3">{p.data.title}</span>
                <span class="ai-post-row__meta">
                  {formatDate(p.data.pubDate, locale, {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                  })}
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

{/* Translation links exposed for the LanguageSwitcher to read at runtime */}
<script is:inline define:vars={{ links: translationLinks }}>
  window.__chirpyTranslations = links;
</script>
