---
import '../styles/global.css';

import { Font } from 'astro:assets';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import BackToTop from '../components/islands/BackToTop.astro';
import { ClientRouter } from 'astro:transitions';
import faviconImg from '../assets/images/site/favicon.png';
import { SITE, THEME, type Locale } from '../config';
import { detectLocale, htmlLang, useTranslations, stripLocale, withBase } from '../i18n/utils';
import { buildSeo, type SeoMeta } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Logical path WITHOUT locale prefix (used for hreflang). */
  pathWithoutLocale?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Constrain main content width (used by Pages like About/404). */
  narrow?: boolean;
  /** Breadcrumb segments shown in the topbar. */
  crumbs?: Array<{ label: string; href?: string }>;
  /** Pre-built SEO meta override. */
  seo?: SeoMeta;
  /**
   * Locales for which a translation of the current page actually
   * exists. Used to limit the language switcher to working links and
   * to scope hreflang alternates. Defaults to all `SITE.locales`.
   */
  availableLocales?: readonly Locale[];
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  narrow = false,
  seo,
  availableLocales,
} = Astro.props;

const locale: Locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
const lang = htmlLang(locale);

const pathWithoutLocale = Astro.props.pathWithoutLocale ?? stripLocale(Astro.url.pathname);
const meta: SeoMeta =
  seo ??
  buildSeo({
    title,
    description,
    pathWithoutLocale,
    fullPath: Astro.url.pathname,
    locale,
    ogImage,
    type,
    publishedTime,
    modifiedTime,
    tags,
    availableLocales,
  });
---

<!doctype html>
<html lang={lang} data-theme={THEME.light}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF4E8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161210" />
    <link rel="icon" type="image/svg+xml" href={withBase(faviconImg.src)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title}`}
      href={withBase('/rss.xml')}
    />
    <SEO meta={meta} />
    {/* Custom fonts configured via Astro Fonts API */}
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
    <ClientRouter />
    {/* Apply persisted theme as early as possible to avoid FOUC. */}
    <script
      is:inline
      define:vars={{ themeLight: THEME.light, themeDark: THEME.dark }}
    >
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var valid = stored === themeDark || stored === themeLight;
            var theme = valid ? stored : prefersDark ? themeDark : themeLight;
            if (!valid && stored) localStorage.setItem('theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
          } catch {
            /* ignore */
          }
        }
        applyTheme();
        // Re-apply after view transitions swap in a fresh <html data-theme>.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="2c18987f-9353-4b5d-a4c6-4a3ba228cfce"></script>
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-primary focus:text-primary-content sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:px-3 focus:py-2"
    >
      {t('site.skipToContent')}
    </a>

    <NavBar locale={locale} />

    <div class="ai-shell">
      <main
        id="main"
        aria-label="Main Content"
        class:list={['min-w-0 flex-1 py-10 lg:py-12', narrow ? 'mx-auto w-full max-w-3xl' : '']}
      >
        <slot />
      </main>
    </div>

    <Footer locale={locale} />

    <BackToTop />
  </body>
</html>

<script is:inline define:vars={{ themeLight: THEME.light, themeDark: THEME.dark }}>
  window.__aiTheme = { light: themeLight, dark: themeDark };
</script>
