---
import BaseLayout from './BaseLayout.astro';
import MathStyles from '../components/MathStyles.astro';
import type { Locale } from '../config';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  crumbs?: Array<{ label: string; href?: string }>;
  /** Load KaTeX CSS for this page only (no global load). */
  math?: boolean;
}

const { title, description, crumbs, math = false } = Astro.props;
---

<BaseLayout title={title} description={description} crumbs={crumbs ?? [{ label: title }]}>
  {math && <MathStyles />}
  <article>
    <div class="ai-page-heading mb-10">
      <h1 class="ai-page-title">{title}</h1>
      {description && <p class="ai-page-meta">{description}</p>}
    </div>
    <div class="prose-ai max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
