---
/**
 * Featured post card: gradient top bar + category chip + Newsreader title
 * + excerpt + author/date meta + "Leer →" CTA.
 */
import type { Locale } from '../config';
import { SITE } from '../config';
import { formatDate, isoDate, useTranslations } from '../i18n/utils';
import { type Post, postPath } from '../utils/posts';
import { readingTime } from '../utils/reading-time';
import CategoryChip from './CategoryChip.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const minutes = readingTime(post.body ?? '').minutes;
const category = post.data.categories[0] ?? '';
---

{
  post && (
    <a href={postPath(post)} class="ai-featured block">
      <span class="ai-featured__grad" aria-hidden="true" />
      <div class="flex flex-col gap-4 p-7 sm:p-10">
        <div class="ai-post-row__kind">
          <CategoryChip label={category} />
          <span class="ai-post-row__meta">{t('home.featured')}</span>
        </div>

        <h2 class="ai-display text-3xl leading-tight sm:text-4xl">{post.data.title}</h2>

        <p class="ai-sub text-base">{post.data.description}</p>

        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
          <span style="color:var(--color-muted)">{SITE.author.name}</span>
          <span aria-hidden="true" style="color:var(--color-muted)">·</span>
          <time
            datetime={isoDate(post.data.pubDate)}
            class="ai-post-row__meta"
          >
            {formatDate(post.data.pubDate, locale, { day: '2-digit', month: 'short', year: 'numeric' })}
          </time>
          <span class="ai-post-row__meta">· {minutes} min</span>
        </div>

        <span class="ai-btn ai-btn-primary mt-2 w-fit px-5 py-2.5">
          {t('home.read')}
          <Icon name="lucide:arrow-right" width={14} height={14} />
        </span>
      </div>
    </a>
  )
}
