---
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import type { Post } from '../utils/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  locale: Locale;
  /** When true, hides the empty state border and shows nothing. */
  silent?: boolean;
}

const { posts, locale, silent = false } = Astro.props;
const t = useTranslations(locale);
const total = posts.length;
---

{
  posts.length === 0 ? (
    !silent && <p class="ai-empty">{t('list.empty')}</p>
  ) : (
    <div id="post-list" class="flex flex-col">
      {posts.map((post, index) => (
        <PostCard post={post} locale={locale} index={index} total={total} />
      ))}
    </div>
  )
}
