---
/**
 * Numbered post row (ai-blog): mono index + category chip + Newsreader
 * title + excerpt + meta + arrow. Used on the home list and listing pages.
 */
import type { Locale } from '../config';
import { formatDate, isoDate } from '../i18n/utils';
import { type Post, postPath } from '../utils/posts';
import { readingTime } from '../utils/reading-time';
import CategoryChip from './CategoryChip.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  post: Post;
  locale: Locale;
  index: number;
  /** Total number of rows in the list (used to zero-pad the index). */
  total?: number;
}

const { post, locale, index, total } = Astro.props;
const href = postPath(post);
const minutes = readingTime(post.body ?? '').minutes;
const digits = String(total ?? 1).length;
const padded = String(index + 1).padStart(digits, '0');
const category = post.data.categories[0] ?? '';
---

<article class="ai-post-row group">
  <a href={href} class="contents" aria-label={post.data.title}>
    <span class="ai-post-row__index" aria-hidden="true">{padded}</span>

    <div class="ai-post-row__body">
      <div class="ai-post-row__kind">
        {category && <CategoryChip label={category} />}
        <time
          datetime={isoDate(post.data.pubDate)}
          class="ai-post-row__meta"
        >
          {formatDate(post.data.pubDate, locale, {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          })}
          {' · '}
          {minutes} min
        </time>
      </div>

      <h2 class="ai-post-row__title">{post.data.title}</h2>

      <p class="ai-post-row__excerpt">{post.data.description}</p>
    </div>

    <span class="ai-post-row__arrow" aria-hidden="true">
      <Icon name="lucide:arrow-up-right" width={18} height={18} />
    </span>
  </a>
</article>
