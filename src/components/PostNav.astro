---
/**
 * ai-blog prev/next navigation: two bordered cards with mono kicker
 * ("← Anterior" / "Siguiente →") + Newsreader title.
 */
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { type Post, postPath } from '../utils/posts';
import { Icon } from 'astro-icon/components';

interface Props {
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { prev, next, locale } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label="Post navigation" class="ai-prevnext">
  {
    prev ? (
      <a href={postPath(prev)} rel="prev" class="ai-prevnext__card">
        <p class="ai-prevnext__kicker">
          <Icon
            name="lucide:arrow-left"
            width={12}
            height={12}
            class="inline align-baseline"
          />
          {t('post.previous')}
        </p>
        <p class="ai-prevnext__title line-clamp-2">{prev.data.title}</p>
      </a>
    ) : (
      <span aria-hidden="true" class="hidden sm:block" />
    )
  }

  {
    next ? (
      <a
        href={postPath(next)}
        rel="next"
        class="ai-prevnext__card sm:text-right"
      >
        <p class="ai-prevnext__kicker">
          {t('post.next')}
          <Icon
            name="lucide:arrow-right"
            width={12}
            height={12}
            class="inline align-baseline"
          />
        </p>
        <p class="ai-prevnext__title line-clamp-2">{next.data.title}</p>
      </a>
    ) : (
      <span aria-hidden="true" class="hidden sm:block" />
    )
  }
</nav>
